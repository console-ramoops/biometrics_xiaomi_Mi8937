cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.xiaomi_wt8937",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint-service.xiaomi_wt8937.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.xiaomi_wt8937.xml"],
    device_specific: true,
    relative_install_path: "hw",
    srcs: [
        "Fingerprint.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libhardware",
        "libutils",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.util",
    ],
}
